# Copy to .env and fill in. NEVER commit .env to GitHub.

# ---------- LLM ----------
# mock = no key needed (testing only) | cohere | anthropic | openai (any OpenAI-compatible API)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Only for OpenAI-compatible providers, e.g.
#   Groq:    https://api.groq.com/openai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1   (local, free, no key)
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
LLM_TIMEOUT=30

# ---------- Retrieval (must match Person 2's ingestion_pipeline.py) ----------
# chroma = Person 2's vector store | keyword = offline fallback (tests only)
RETRIEVER=chroma
# Paths are relative to this backend/ folder
CHROMA_DIR=../db/chroma_db
CHROMA_COLLECTION=langchain
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_BASE_DIR=../knowledge_base
TOP_K=4
# Cosine relevance 0-1. Chunks below this are ignored; tune on real test questions.
MIN_RELEVANCE=0.35

# ---------- Chat ----------
HISTORY_TURNS=3
MAX_QUESTION_CHARS=1000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
